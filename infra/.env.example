# ==============================================================================
# SANRAKSHAN ENVIRONMENT CONFIGURATION TEMPLATE
# NOTE: This template contains secret variable names ONLY, NEVER secret values!
# For local dev, copy this file to .env and provide safe mock credentials.
# ==============================================================================

# Environment Identifier
ENVIRONMENT=local
PROJECT_NAME=sanrakshan

# PostgreSQL / PostGIS Database Configuration
POSTGRES_DB=sanrakshan_db
POSTGRES_USER=sanrakshan_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/sanrakshan_db

# Apache Kafka Configuration (KRaft Mode)
KAFKA_BROKER_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLUSTER_ID=

# Neo4j Graph Database Configuration
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH_USER=neo4j
NEO4J_AUTH_PASSWORD=
NEO4J_URI=bolt://neo4j:7687

# MinIO / AWS S3 Compatible Storage Configuration
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=sanrakshan-evidence
S3_REGION=us-east-1

# Backend Service Configuration
BACKEND_PORT=8080
JWT_SECRET_KEY=
JWT_EXPIRATION_SECONDS=3600

# Python ML Microservice Configuration
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://ml-services:8001

# Frontend Ports
OPERATOR_PORT=3000
VERIFIER_PORT=3001
